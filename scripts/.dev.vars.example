# 本地开发用（`wrangler dev`）。复制成 .dev.vars 后填写真实值。
# 线上请改用：npx wrangler secret put <名称>
# 注意：.dev.vars 已在 .gitignore 中，切勿提交到仓库。

# ===== 云备份 =====

# 备份用的 S3 / R2(S3 接口) 私钥（可留空，改用页面上填写的密钥）
BACKUP_S3_SECRET_KEY=

# 备份用的 WebDAV 密码（可留空，改用页面上填写的密码）
BACKUP_WEBDAV_PASSWORD=

# ===== 到期提醒 =====
# 全部可留空：留空时以页面「到期提醒」里填的为准，这里只是兜底。
# 适合「不想把密钥存进 D1 数据库」的场景。

# Bark Device Key
NOTIFY_BARK_KEY=

# Gotify App Token
NOTIFY_GOTIFY_TOKEN=

# WxPusher AppToken（AT_ 开头）
NOTIFY_WXPUSHER_APPTOKEN=

# Telegram Bot Token（形如 123456:ABC-DEF...）
NOTIFY_TELEGRAM_BOT_TOKEN=

# Server 酱 SendKey（SCT 开头）
NOTIFY_SERVERCHAN_KEY=

# PushPlus Token
NOTIFY_PUSHPLUS_TOKEN=

# 邮件推送用的 Resend API Key（re_ 开头）
NOTIFY_RESEND_API_KEY=
